+const _buildApiUrl = (): string => {
+if (!_configuredApiUrl) return window.location.origin + '/api';
+const normalized = /^https?:\/\//.test(_configuredApiUrl) ? _configuredApiUrl : `https://${_configuredApiUrl}`;
+return normalized.replace(/\/$/, '') + '/api';
+};
+
+const _apiOrigin = _configuredApiUrl
+? (/^https?:\/\//.test(_configuredApiUrl) ? _configuredApiUrl : `https://${_configuredApiUrl}`).replace(/\/$/, '')
+: window.location.origin;
