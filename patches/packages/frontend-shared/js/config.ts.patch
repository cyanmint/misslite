+const address = new URL(window.location.href);
 const siteName = window.document.querySelector<HTMLMetaElement>('meta[property="og:site_name"]')?.content;
 
+type RuntimeConfig = {
+	defaultApiUrl?: string;
+};
+
+type MissliteWindow = Window & {
+	MISSKEY_CONFIG?: RuntimeConfig;
+	__missliteScopedGet?: (key: string) => string | null;
+	__missliteScopedSet?: (key: string, value: string) => void;
+	__missliteScopedRemove?: (key: string) => void;
+};
+
+const missliteWindow = window as MissliteWindow;
+
+// Get runtime configuration from config.js (if available)
+const runtimeConfig = missliteWindow.MISSKEY_CONFIG ?? {};
+const defaultApiUrl = runtimeConfig.defaultApiUrl ?? '';
+
+// Determine API domain from the search string.
+// Format: https://frontend.com/?misskey.io
+// The entire query string (after ?) is the domain name.
+let queryDomain = window.location.search.slice(1).trim();
+
+// Fallback: handle pathname-embedded query (/?domain)
+if (!queryDomain && window.location.pathname.startsWith('/?') && window.location.pathname.length > 2) {
+	queryDomain = window.location.pathname.substring(2).trim();
+}
+
+// If no search string but a defaultApiUrl is configured, redirect to include it.
+// If neither is set, leave queryDomain empty — index.html will show the landing page.
+if (!queryDomain && defaultApiUrl) {
+	queryDomain = defaultApiUrl;
+	const newUrl = `${window.location.origin}${window.location.pathname}?${queryDomain}${window.location.hash}`;
+	window.history.replaceState({}, '', newUrl);
+}
+
+// The API domain is always derived from the search string — no localStorage involved.
+const apiDomain = queryDomain;
+
+// Build a sanitized key prefix so that each API domain gets its own localStorage partition.
+// This allows two tabs pointing at different servers to maintain independent sessions.
+const domainKey = apiDomain.replace(/[^a-zA-Z0-9.-]/g, '_');
+
+// Scoped localStorage helpers used by the rest of the frontend.
+// Every key stored via miLocalStorage will be prefixed with the domain key.
+function scopedGet(key: string): string | null {
+	return localStorage.getItem(`${domainKey}::${key}`);
+}
+
+function scopedSet(key: string, value: string): void {
+	localStorage.setItem(`${domainKey}::${key}`, value);
+}
+
+// Expose scoped helpers globally so miLocalStorage can use them
+missliteWindow.__missliteScopedGet = scopedGet;
+missliteWindow.__missliteScopedSet = scopedSet;
+missliteWindow.__missliteScopedRemove = (key: string) => localStorage.removeItem(`${domainKey}::${key}`);
+
+// Construct API URL from domain
+const determineApiUrl = (): string => {
+	const domain = apiDomain;
+	if (!domain) return '';
+	if (domain.startsWith('http') && domain.includes('/api')) {
+		return domain;
+	}
+	if (domain === window.location.hostname) {
+		return `${window.location.origin}/api`;
+	}
+	const cleanDomain = domain.replace(/^https?:\/\//, '').replace(/\/.*$/, '');
+	return `https://${cleanDomain}/api`;
+};
+
+const determineWsOrigin = (): string => {
+	const domain = apiDomain;
+	if (!domain) return '';
+	if (domain.startsWith('http')) {
+		try {
+			return new URL(domain).origin;
+		} catch {
+			return window.location.origin;
+		}
+	}
+	if (domain === window.location.hostname) {
+		return window.location.origin;
+	}
+	const cleanDomain = domain.replace(/\/.*$/, '');
+	return `https://${cleanDomain}`;
+};
+
 export const host = address.host;
