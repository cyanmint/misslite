+
+/**
+ * Sanitize domain string for safe use as storage key
+ * Removes protocol, path, and special characters
+ * @param domain - Domain string to sanitize (e.g., 'https://example.com/path' or 'example.com')
+ * @returns Sanitized domain safe for use as storage key (e.g., 'example.com')
+ */
+export function sanitizeDomain(domain: string): string {
+return domain
+.replace(/^https?:\/\//, '') // Remove protocol
+.replace(/\/.*$/, '') // Remove path
+.replace(/[^a-zA-Z0-9.-]/g, '_'); // Replace special chars with underscore
+}
