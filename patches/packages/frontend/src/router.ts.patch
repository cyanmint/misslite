--- a/packages/frontend/src/router.ts
+++ b/packages/frontend/src/router.ts
@@ -19,2 +19,36 @@ export function createRouter(fullPath: string): Router {
 
+// Helper function to get API domain from query string
+export function getApiDomainQueryString(): string {
+const search = window.location.search;
+if (search && search.length > 1) {
+// Query string format is ?domain (e.g., ?misskey.io)
+return search;
+}
+return '';
+}
+
+// Helper function to append API domain query string to path if needed
+export function appendApiDomainQuery(fullPath: string): string {
+const apiQuery = getApiDomainQueryString();
+if (!apiQuery) return fullPath;
+
+// If path starts with http or //, it's an absolute URL - just return it
+if (fullPath.startsWith('http://') || fullPath.startsWith('https://') || fullPath.startsWith('//')) {
+return fullPath;
+}
+
+// If path already has query string, append API domain to it
+if (fullPath.includes('?')) {
+// Check if it already has the API domain query
+if (fullPath.includes(apiQuery)) {
+return fullPath;
+}
+// Add API domain to existing query string
+return fullPath + '&' + apiQuery.substring(1);
+}
+
+// If path has no query string, add the API domain query
+return fullPath + apiQuery;
+}
+
 export const mainRouter = createRouter(window.location.pathname + window.location.search + window.location.hash);
@@ -26,3 +60,4 @@ window.addEventListener('popstate', (event) => {
 mainRouter.addListener('push', ctx => {
-	window.history.pushState({ }, '', ctx.fullPath);
+	const fullPathWithQuery = appendApiDomainQuery(ctx.fullPath);
+	window.history.pushState({ }, '', fullPathWithQuery);
 });
@@ -30,3 +65,4 @@ mainRouter.addListener('push', ctx => {
 mainRouter.addListener('replace', ctx => {
-	window.history.replaceState({ }, '', ctx.fullPath);
