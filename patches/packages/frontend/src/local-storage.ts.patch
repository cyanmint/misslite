+// Use scoped localStorage when running in multi-server mode.
+// The scoped helpers are installed by config.ts on the window object.
+// They prefix every key with the active API domain so that two tabs
+// pointing at different servers maintain independent storage.
+const scopedGet = (key: string): string | null => {
+const fn = (window as any).__missliteScopedGet;
+return fn ? fn(key) : window.localStorage.getItem(key);
+};
+
+const scopedSet = (key: string, value: string): void => {
+const fn = (window as any).__missliteScopedSet;
+if (fn) fn(key, value); else window.localStorage.setItem(key, value);
+};
+
+const scopedRemove = (key: string): void => {
+const fn = (window as any).__missliteScopedRemove;
+if (fn) fn(key); else window.localStorage.removeItem(key);
+};
 
