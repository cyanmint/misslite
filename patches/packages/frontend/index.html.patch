+<!DOCTYPE html>
+<!--
+SPDX-FileCopyrightText: syuilo and misskey-project
+SPDX-License-Identifier: AGPL-3.0-only
+-->
+<html>
+<head>
+<meta charset="UTF-8">
+<meta name="application-name" content="Misskey">
+<meta name="referer" content="origin">
+<meta name="theme-color" content="#86b300">
+<meta name="theme-color-orig" content="#86b300">
+<meta property="og:site_name" content="Misskey">
+<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
+<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
+<link rel="icon" href="/favicon.ico">
+<link rel="apple-touch-icon" href="/apple-touch-icon.png">
+<link rel="manifest" href="/app.webmanifest">
+<script src="/config.js"></script>
+<title>Misslite</title>
+<style id="splash-style">
+#splash {
+background: #86b300;
+}
+</style>
+<script>
+// Apply default theme immediately to avoid flash of unstyled content.
+(function() {
+// Always force runtime theme regeneration to avoid stale/incomplete cached
+// variable sets from older sessions that can leave menus partially unstyled.
+localStorage.removeItem('themeCachedVersion');
+const colorScheme = localStorage.getItem('colorScheme') || 'light';
+document.documentElement.setAttribute('data-color-scheme', colorScheme);
+document.documentElement.style.setProperty('color-scheme', colorScheme);
+const defaultLightTheme = {
+accent: '#86b300', bg: '#fff', fg: '#5f5f5f', panel: '#f3f5f7',
+acrylicBg: 'rgba(255, 255, 255, 0.5)',
+fgTransparent: 'rgba(95, 95, 95, 0.5)', fgTransparentWeak: 'rgba(95, 95, 95, 0.75)',
+fgHighlighted: '#333', fgOnAccent: '#fff', fgOnWhite: '#5f5f5f',
+divider: 'rgba(0, 0, 0, 0.1)', indicator: '#86b300',
+popup: '#fff', modalBg: 'rgba(0, 0, 0, 0.3)',
+shadow: 'rgba(0, 0, 0, 0.16)', link: '#44a4c1', hashtag: '#86b300',
+header: 'rgba(255, 255, 255, 0.85)', navBg: '#f3f5f7', navFg: '#5f5f5f',
+navHoverFg: '#333', navActive: '#86b300', navIndicator: '#86b300',
+mention: '#86b300', mentionMe: '#86b300', renote: '#89DC6F',
+infoFg: '#5f5f5f', infoWarnFg: '#ab5706', infoWarnBg: 'rgba(255, 161, 0, 0.1)',
+buttonBg: 'rgba(0, 0, 0, 0.05)', buttonHoverBg: 'rgba(0, 0, 0, 0.1)',
+inputBorder: 'rgba(0, 0, 0, 0.1)', inputBorderHover: 'rgba(0, 0, 0, 0.2)',
+listItemHoverBg: 'rgba(0, 0, 0, 0.03)',
+wallpaperOverlay: 'rgba(255, 255, 255, 0.5)', windowHeader: 'rgba(243, 245, 247, 0.85)',
+dateLabelFg: '#86b300', scrollbarHandle: 'rgba(0, 0, 0, 0.2)', scrollbarHandleHover: 'rgba(0, 0, 0, 0.4)',
+htmlThemeColor: '#fff',
+};
+const defaultDarkTheme = {
+accent: '#86b300', bg: '#181818', fg: '#dadada', panel: '#222',
+acrylicBg: 'rgba(24, 24, 24, 0.5)',
+fgTransparent: 'rgba(218, 218, 218, 0.5)', fgTransparentWeak: 'rgba(218, 218, 218, 0.75)',
+fgHighlighted: '#fff', fgOnAccent: '#fff', fgOnWhite: '#5f5f5f',
+divider: 'rgba(255, 255, 255, 0.1)', indicator: '#86b300',
+popup: '#252525', modalBg: 'rgba(0, 0, 0, 0.7)',
+shadow: 'rgba(0, 0, 0, 0.3)', link: '#44a4c1', hashtag: '#86b300',
+header: 'rgba(24, 24, 24, 0.85)', navBg: '#222', navFg: '#dadada',
+navHoverFg: '#fff', navActive: '#86b300', navIndicator: '#86b300',
+mention: '#86b300', mentionMe: '#86b300', renote: '#89DC6F',
+infoFg: '#dadada', infoWarnFg: '#e6b869', infoWarnBg: 'rgba(230, 184, 105, 0.1)',
+buttonBg: 'rgba(255, 255, 255, 0.05)', buttonHoverBg: 'rgba(255, 255, 255, 0.1)',
+inputBorder: 'rgba(255, 255, 255, 0.1)', inputBorderHover: 'rgba(255, 255, 255, 0.2)',
+listItemHoverBg: 'rgba(255, 255, 255, 0.03)',
+wallpaperOverlay: 'rgba(0, 0, 0, 0.5)', windowHeader: 'rgba(34, 34, 34, 0.85)',
+dateLabelFg: '#86b300', scrollbarHandle: 'rgba(255, 255, 255, 0.2)', scrollbarHandleHover: 'rgba(255, 255, 255, 0.4)',
+htmlThemeColor: '#000',
+};
+const defaultTheme = colorScheme === 'dark' ? defaultDarkTheme : defaultLightTheme;
+for (const [k, v] of Object.entries(defaultTheme)) {
+document.documentElement.style.setProperty('--MI_THEME-' + k, v);
+}
+const themeColorMeta = document.querySelector('meta[name="theme-color"]');
+if (themeColorMeta) themeColorMeta.setAttribute('content', defaultTheme.htmlThemeColor);
+const loadCustomTheme = () => {
+const theme = localStorage.getItem('theme');
+if (theme) {
+try {
+const themeObj = JSON.parse(theme);
+if (themeObj && typeof themeObj === 'object' && !Array.isArray(themeObj)) {
+for (const [k, v] of Object.entries(themeObj)) {
+document.documentElement.style.setProperty('--MI_THEME-' + k, v);
+}
+if (themeColorMeta && themeObj.htmlThemeColor) {
+themeColorMeta.setAttribute('content', themeObj.htmlThemeColor);
+}
+} else {
+localStorage.removeItem('themeId');
+localStorage.removeItem('themeCachedVersion');
+}
+} catch (e) {
+console.warn('Failed to apply cached theme:', e);
+localStorage.removeItem('themeId');
+localStorage.removeItem('themeCachedVersion');
+}
+} else {
+// Force runtime theme initialization when cache payload is missing.
+localStorage.removeItem('themeId');
+localStorage.removeItem('themeCachedVersion');
+}
+};
+loadCustomTheme();
+})();
+</script>
+</head>
+<body>
+<div id="splash">
+<div id="splashIcon" style="display:flex;justify-content:center;align-items:center;height:100vh;">
+<svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
+<circle cx="12" cy="12" r="10" stroke="white" stroke-width="2" opacity="0.3"/>
+<path d="M12 2a10 10 0 0 1 10 10" stroke="white" stroke-width="2" stroke-linecap="round">
+<animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
+</path>
+</svg>
+</div>
+</div>
+<div id="misskey_app"></div>
+<script type="module">
+import('./src/_boot_.ts');
+</script>
+</body>
+</html>
