+<!DOCTYPE html>
+<!--
+SPDX-FileCopyrightText: syuilo and misskey-project
+SPDX-License-Identifier: AGPL-3.0-only
+-->
+<html>
+<head>
+<meta charset="UTF-8">
+<meta name="application-name" content="Misskey">
+<meta name="referer" content="origin">
+<meta name="theme-color" content="#86b300">
+<meta name="theme-color-orig" content="#86b300">
+<meta property="og:site_name" content="Misskey">
+<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
+<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
+<link rel="icon" href="./favicon.ico">
+<link rel="apple-touch-icon" href="./apple-touch-icon.png">
+<link rel="manifest" href="./app.webmanifest">
+<script>
+// Normalize URL format: /?domain should be treated as / with ?domain query string
+(function() {
+const pathname = window.location.pathname;
+if (pathname.startsWith('/?') && pathname.length > 2) {
+const domain = pathname.substring(2);
+const newUrl = window.location.origin + '/?' + domain + window.location.hash;
+window.history.replaceState({}, '', newUrl);
+}
+})();
+</script>
+<script src="./config.js"></script>
+<title>Misskey</title>
+<style id="splash-style">
+#splash {
+background: #86b300;
+}
+</style>
+<script>
+// Apply default theme immediately
+(function() {
+const colorScheme = localStorage.getItem('colorScheme') || 'light';
+document.documentElement.setAttribute('data-color-scheme', colorScheme);
+document.documentElement.style.setProperty('color-scheme', colorScheme);
+
+const defaultLightTheme = {
+accent: '#86b300', bg: '#fff', fg: '#5f5f5f', panel: '#f3f5f7',
+divider: 'rgba(0, 0, 0, 0.1)', modalBg: 'rgba(0, 0, 0, 0.3)',
+link: '#44a4c1', htmlThemeColor: '#fff', shadow: 'rgba(0, 0, 0, 0.1)',
+buttonBg: '#e8eaec', buttonHoverBg: '#dfe1e3',
+};
+const defaultDarkTheme = {
+accent: '#86b300', bg: '#000', fg: '#dadada', panel: '#0f0f0f',
+divider: 'rgba(255, 255, 255, 0.1)', modalBg: 'rgba(0, 0, 0, 0.7)',
+link: '#44a4c1', htmlThemeColor: '#000', shadow: 'rgba(0, 0, 0, 0.3)',
+buttonBg: '#1e1e1e', buttonHoverBg: '#2d2d2d',
+};
+
+const defaultTheme = colorScheme === 'dark' ? defaultDarkTheme : defaultLightTheme;
+for (const [k, v] of Object.entries(defaultTheme)) {
+document.documentElement.style.setProperty('--MI_THEME-' + k, v);
+}
+const themeColorMeta = document.querySelector('meta[name="theme-color"]');
+if (themeColorMeta) themeColorMeta.setAttribute('content', defaultTheme.htmlThemeColor);
+
+const loadCustomTheme = () => {
+const theme = localStorage.getItem('theme');
+if (theme) {
+try {
+const themeObj = JSON.parse(theme);
+for (const [k, v] of Object.entries(themeObj)) {
+document.documentElement.style.setProperty('--MI_THEME-' + k, v);
+}
+if (themeColorMeta && themeObj.htmlThemeColor) {
+themeColorMeta.setAttribute('content', themeObj.htmlThemeColor);
+}
+} catch (e) { console.warn('Failed to apply cached theme:', e); }
+}
+};
+if (typeof requestIdleCallback !== 'undefined') {
+requestIdleCallback(loadCustomTheme, { timeout: 100 });
+} else {
+setTimeout(loadCustomTheme, 0);
+}
+})();
+</script>
+</head>
+<body>
+<div id="splash">
+<div id="splashIcon" style="display:flex;justify-content:center;align-items:center;height:100vh;">
+<svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
+<circle cx="12" cy="12" r="10" stroke="white" stroke-width="2" opacity="0.3"/>
+<path d="M12 2a10 10 0 0 1 10 10" stroke="white" stroke-width="2" stroke-linecap="round">
+<animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
+</path>
+</svg>
+</div>
+</div>
+<div id="misskey_app"></div>
+<script type="module" src="./src/_boot_.ts"></script>
+</body>
+</html>
