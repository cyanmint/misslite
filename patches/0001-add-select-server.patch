+// Helper function to get API domain from query string
+export function getApiDomainQueryString(): string {
+	const search = window.location.search;
+	if (search && search.length > 1) {
+		// Query string format is ?domain (e.g., ?misskey.io)
+		return search;
+	}
+	return '';
