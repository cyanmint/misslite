+// Helper function to append API domain query string to path if needed
+export function appendApiDomainQuery(fullPath: string): string {
+	const apiQuery = getApiDomainQueryString();
+	if (!apiQuery) return fullPath;
+	
+	// If path starts with http or //, it's an absolute URL - just return it
+	if (fullPath.startsWith('http://') || fullPath.startsWith('https://') || fullPath.startsWith('//')) {
+		return fullPath;
+	}
+	
+	// If path already has query string, append API domain to it
+	if (fullPath.includes('?')) {
+		// Check if it already has the API domain query
+		if (fullPath.includes(apiQuery)) {
+			return fullPath;
+		}
+		// Add API domain to existing query string
+		return fullPath + '&' + apiQuery.substring(1);
+	}
+	
+	// If path has no query string, add the API domain query
+	return fullPath + apiQuery;
+}
