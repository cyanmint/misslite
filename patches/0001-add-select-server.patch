+	window.document.documentElement.style.setProperty('--MI_THEME-link', defaultAccent);
+	
+	// Set body and documentElement background
+	const defaultBg = colorScheme === 'dark' ? defaultDarkBg : defaultLightBg;
+	window.document.body.style.background = defaultBg;
+	window.document.documentElement.style.background = defaultBg;
+}
+
+function cancel() {
+	dialogEl.value?.close();
