+			const sessionKey = `session_${sanitizeDomain(currentDomain)}`;
+			const currentAccount = localStorage.getItem('account');
+			if (currentAccount) {
+				localStorage.setItem(sessionKey, currentAccount);
+			}
+		}
+		
+		localStorage.setItem('customApiDomain', domain);
+		
+		// Clean up old storage keys (backward compatibility)
+		localStorage.removeItem('customApiUrl');
+		localStorage.removeItem('customWsOrigin');
+		
+		// Try to restore session for the new domain
+		const savedSessionKey = `session_${sanitizeDomain(domain)}`;
+		const savedSession = localStorage.getItem(savedSessionKey);
+		
+		if (savedSession) {
+			localStorage.setItem('account', savedSession);
+		} else {
+			localStorage.removeItem('account');
+		}
+		
+		// Small delay to ensure theme changes are processed before navigation
+		await new Promise(resolve => window.setTimeout(resolve, 50));
+		
+		// Navigate with query string
+		if (savedSession) {
+			// If session exists, stay on current page by reloading
+			window.location.href = `${window.location.pathname}?${domain}`;
+		} else {
+			// No session, navigate to home/login page
+			window.location.href = `/?${domain}`;
+		}
+	} else {
+		// Apply default theme before resetting
+		applyDefaultTheme();
+		
+		localStorage.removeItem('customApiDomain');
+		localStorage.removeItem('customApiUrl');
+		localStorage.removeItem('customWsOrigin');
+		
+		// Small delay to ensure theme changes are processed
+		await new Promise(resolve => window.setTimeout(resolve, 50));
+		
+		// Reload to default
+		window.location.reload();
