+	<link rel="manifest" href="/manifest.json">
+	<script>
+		// Normalize URL format: /?domain should be treated as / with ?domain query string
+		// This fixes cases where browser treats /?domain as path instead of query
+		(function() {
+			const pathname = window.location.pathname;
+			// Check if pathname is like /?something (starts with /? and has content after)
+			if (pathname.startsWith('/?') && pathname.length > 2) {
+				// Extract the domain from pathname: /?misskey.io → misskey.io
+				const domain = pathname.substring(2); // Remove /?
+				// Reconstruct proper URL: / with ?domain query string
+				const newUrl = window.location.origin + '/?' + domain + window.location.hash;
+				// Update URL without reload using replaceState
+				window.history.replaceState({}, '', newUrl);
+				// Note: window.location now has correct pathname=/ and search=?domain
+			}
+		})();
