index 0000000..8a583ec
--- /dev/null
+++ b/scripts/copy-to-webroot.mjs
@@ -0,0 +1,116 @@
+// @ts-check
+/*
+ * NOTE: This file was generated with AI assistance (GitHub Copilot) and is not subject to copyright.
+ * The file as a whole is licensed under AGPL-3.0 as part of the MissLite project.
+ * 
+ * SPDX-FileCopyrightText: syuilo and misskey-project
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+const rootDir = path.resolve(__dirname, '..');
+const webrootDir = path.resolve(rootDir, 'webroot');
+
+/**
+ * Recursively copy directory contents
+ */
+function copyDir(src, dest) {
+	fs.mkdirSync(dest, { recursive: true });
+	const entries = fs.readdirSync(src, { withFileTypes: true });
+
+	for (const entry of entries) {
+		const srcPath = path.join(src, entry.name);
+		const destPath = path.join(dest, entry.name);
+
+		if (entry.isDirectory()) {
+			copyDir(srcPath, destPath);
+		} else {
+			fs.copyFileSync(srcPath, destPath);
+		}
+	}
+}
+
+console.log('[copy-to-webroot] Copying frontend components to webroot...');
+
+// Copy service worker (sw.js) from built/_sw_dist_/
+const swSrc = path.resolve(rootDir, 'built/_sw_dist_/sw.js');
+const swDest = path.resolve(webrootDir, 'sw.js');
+if (fs.existsSync(swSrc)) {
+	fs.copyFileSync(swSrc, swDest);
+	console.log('[copy-to-webroot] ✓ Service worker copied: sw.js');
+} else {
+	console.warn('[copy-to-webroot] ⚠ Service worker not found:', swSrc);
+}
+
+// Copy frontend-embed from built/_frontend_embed_vite_/
+const embedSrc = path.resolve(rootDir, 'built/_frontend_embed_vite_');
+const embedDest = path.resolve(webrootDir, 'embed_vite');
+if (fs.existsSync(embedSrc)) {
+	copyDir(embedSrc, embedDest);
+	console.log('[copy-to-webroot] ✓ Frontend embed copied to: embed_vite/');
+} else {
+	console.warn('[copy-to-webroot] ⚠ Frontend embed not found:', embedSrc);
+}
+
+// Copy i18n locales from built/_frontend_dist_/locales
+// The server maps /assets/ prefix to webroot/, so /assets/locales/... → webroot/locales/...
+const localesSrc = path.resolve(rootDir, 'built/_frontend_dist_/locales');
+const localesDest = path.resolve(webrootDir, 'locales');
+if (fs.existsSync(localesSrc)) {
+	copyDir(localesSrc, localesDest);
+	const localeFiles = fs.readdirSync(localesSrc).filter(f => f.endsWith('.json'));
+	console.log(`[copy-to-webroot] ✓ i18n locales copied: ${localeFiles.length} files to locales/`);
+} else {
+	console.warn('[copy-to-webroot] ⚠ i18n locales not found:', localesSrc);
+}
+
+// Copy frontend assets (bubble game, emoji selector, etc.) to webroot/client-assets/
+const frontendAssetsSrc = path.resolve(rootDir, 'packages/frontend/assets');
+const frontendAssetsDest = path.resolve(webrootDir, 'client-assets');
+if (fs.existsSync(frontendAssetsSrc)) {
+	copyDir(frontendAssetsSrc, frontendAssetsDest);
+	console.log('[copy-to-webroot] ✓ Frontend assets copied to: client-assets/');
+} else {
+	console.warn('[copy-to-webroot] ⚠ Frontend assets not found:', frontendAssetsSrc);
+}
+
+// Copy fluent-emojis/dist to webroot/fluent-emoji/ (for achievements and about page)
+const fluentEmojiSrc = path.resolve(rootDir, 'fluent-emojis/dist');
+const fluentEmojiDest = path.resolve(webrootDir, 'fluent-emoji');
+if (fs.existsSync(fluentEmojiSrc)) {
+	copyDir(fluentEmojiSrc, fluentEmojiDest);
+	console.log('[copy-to-webroot] ✓ Fluent emojis copied to: fluent-emoji/');
+} else {
+	console.warn('[copy-to-webroot] ⚠ Fluent emojis not found:', fluentEmojiSrc);
+}
+
+// Copy backend static assets to webroot for Cloudflare Pages deployments
+// The backend serves these at /static-assets/ and /favicon.ico etc.
+// On Cloudflare Pages, these are served directly from webroot instead
+const backendAssetsSrc = path.resolve(rootDir, 'packages/backend/assets');
+const backendAssetsStaticDest = path.resolve(webrootDir, 'static-assets');
+if (fs.existsSync(backendAssetsSrc)) {
+	copyDir(backendAssetsSrc, backendAssetsStaticDest);
+	// Also copy favicon.ico directly to webroot root for /favicon.ico route
+	const faviconSrc = path.resolve(backendAssetsSrc, 'favicon.ico');
+	const faviconDest = path.resolve(webrootDir, 'favicon.ico');
+	if (fs.existsSync(faviconSrc)) {
+		fs.copyFileSync(faviconSrc, faviconDest);
+	}
+	// Also copy apple-touch-icon.png to webroot root
+	const appleTouchSrc = path.resolve(backendAssetsSrc, 'apple-touch-icon.png');
+	const appleTouchDest = path.resolve(webrootDir, 'apple-touch-icon.png');
+	if (fs.existsSync(appleTouchSrc)) {
+		fs.copyFileSync(appleTouchSrc, appleTouchDest);
+	}
+	console.log('[copy-to-webroot] ✓ Backend static assets copied to: static-assets/');
+} else {
+	console.warn('[copy-to-webroot] ⚠ Backend assets not found:', backendAssetsSrc);
+}
+
+console.log('[copy-to-webroot] All components copied successfully!');
