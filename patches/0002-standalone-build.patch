+<html>
+<head>
+	<meta charset="UTF-8">
+	<meta name="application-name" content="Misskey">
+	<meta name="referer" content="origin">
+	<meta name="theme-color" content="#86b300">
+	<meta name="theme-color-orig" content="#86b300">
+	<meta property="og:site_name" content="Misskey">
+	<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
+	<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
+	<link rel="icon" href="/favicon.ico">
+	<link rel="apple-touch-icon" href="/apple-touch-icon.png">
+	<link rel="manifest" href="/manifest.json">
+	<script>
+		// Normalize URL format: /?domain should be treated as / with ?domain query string
+		// This fixes cases where browser treats /?domain as path instead of query
+		(function() {
+			const pathname = window.location.pathname;
+			// Check if pathname is like /?something (starts with /? and has content after)
+			if (pathname.startsWith('/?') && pathname.length > 2) {
+				// Extract the domain from pathname: /?misskey.io → misskey.io
+				const domain = pathname.substring(2); // Remove /?
+				// Reconstruct proper URL: / with ?domain query string
+				const newUrl = window.location.origin + '/?' + domain + window.location.hash;
+				// Update URL without reload using replaceState
+				window.history.replaceState({}, '', newUrl);
+				// Note: window.location now has correct pathname=/ and search=?domain
+			}
+		})();
+	</script>
+	<script src="/config.js"></script>
+	<title>Misskey</title>
+	<style id="splash-style">
+		/* Default green splash background */
+		#splash {
+			background: #86b300;
+		}
+	</style>
+	<script>
+		// Apply default hardcoded theme immediately, then try to load custom theme asynchronously
+		(function() {
+			const colorScheme = localStorage.getItem('colorScheme') || 'light';
+			document.documentElement.setAttribute('data-color-scheme', colorScheme);
+			document.documentElement.style.setProperty('color-scheme', colorScheme);
+			
+			// Hardcoded default themes for instant loading
+			const defaultLightTheme = {
+				accent: '#86b300',
+				bg: '#fff',
+				fg: '#5f5f5f',
+				panel: '#f3f5f7',
+				divider: 'rgba(0, 0, 0, 0.1)',
+				modalBg: 'rgba(0, 0, 0, 0.3)',
+				windowHeader: 'rgba(243, 245, 247, 0.85)',
+				link: '#44a4c1',
+				htmlThemeColor: '#fff',
+				shadow: 'rgba(0, 0, 0, 0.1)',
+				buttonBg: '#e8eaec',
+				buttonHoverBg: '#dfe1e3',
+			};
+			
+			const defaultDarkTheme = {
+				accent: '#86b300',
+				bg: '#000',
+				fg: '#dadada',
+				panel: '#0f0f0f',
+				divider: 'rgba(255, 255, 255, 0.1)',
+				modalBg: 'rgba(0, 0, 0, 0.7)',
+				windowHeader: 'rgba(15, 15, 15, 0.85)',
+				link: '#44a4c1',
+				htmlThemeColor: '#000',
+				shadow: 'rgba(0, 0, 0, 0.3)',
+				buttonBg: '#1e1e1e',
+				buttonHoverBg: '#2d2d2d',
+			};
+			
+			// Apply default theme immediately
+			const defaultTheme = colorScheme === 'dark' ? defaultDarkTheme : defaultLightTheme;
+			for (const [k, v] of Object.entries(defaultTheme)) {
+				document.documentElement.style.setProperty(`--MI_THEME-${k}`, v);
+			}
+			
+			// Set theme-color meta tag
+			const themeColorMeta = document.querySelector('meta[name="theme-color"]');
+			if (themeColorMeta) {
+				themeColorMeta.setAttribute('content', defaultTheme.htmlThemeColor);
+			}
+			
+			// Asynchronously try to load custom theme from localStorage
+			// This won't block page rendering
+			const loadCustomTheme = () => {
+				const theme = localStorage.getItem('theme');
+				if (theme) {
+					try {
+						const themeObj = JSON.parse(theme);
+						// Apply cached custom theme properties
+						for (const [k, v] of Object.entries(themeObj)) {
+							document.documentElement.style.setProperty(`--MI_THEME-${k}`, v);
+						}
+						if (themeColorMeta && themeObj.htmlThemeColor) {
+							themeColorMeta.setAttribute('content', themeObj.htmlThemeColor);
+						}
+					} catch (e) {
+						console.warn('Failed to apply cached theme, using defaults:', e);
+					}
+				}
+			};
+			
+			// Use requestIdleCallback if available, otherwise use setTimeout
+			if (typeof requestIdleCallback !== 'undefined') {
+				requestIdleCallback(loadCustomTheme, { timeout: 100 });
+			} else {
+				setTimeout(loadCustomTheme, 0);
+			}
+		})();
+	</script>
+</head>
